# Server
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Database (Supabase / Render Postgres / any Postgres connection string)
DATABASE_URL="postgresql://user:password@host:5432/kalamkari?schema=public"

# Google OAuth (from Google Cloud Console > APIs & Services > Credentials)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# JWT
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=30d

# Cloudinary (for product image storage)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# WhatsApp order notifications (sent to the shop owner when a new order comes in)
# Provider: "callmebot" (free, one fixed number — recommended to start) | "meta" | "none"
WHATSAPP_PROVIDER=callmebot
WHATSAPP_ADMIN_PHONE=919876543210
WHATSAPP_CALLMEBOT_APIKEY=your-callmebot-apikey

# Only needed if WHATSAPP_PROVIDER=meta
WHATSAPP_META_PHONE_NUMBER_ID=
WHATSAPP_META_ACCESS_TOKEN=
